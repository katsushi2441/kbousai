# kbousai の設定（systemd の EnvironmentFile）。書かなければ既定値で動く
# 連携するエンジン（同じサーバーなら既定のままでよい）
#KBOUSAI_KFLOOD=http://127.0.0.1:18386
#KBOUSAI_KHAZARD=http://127.0.0.1:18376
#KBOUSAI_KTSUNAMI=http://127.0.0.1:18380
#KBOUSAI_KREFUGE=http://127.0.0.1:18378
# AI の言い換え（Ollama）。止まっていても規則の答えとカードは出る
KBOUSAI_OLLAMA=http://127.0.0.1:11434
KBOUSAI_MODEL=gemma4:12b-it-qat
KBOUSAI_AI_LABEL=gemma4
# 画面
KBOUSAI_PUBLIC_URL=https://example.jp/kbousai.php/
KBOUSAI_BRAND=防災AIチャット
KBOUSAI_BRAND_SUB=
KBOUSAI_LOGO_URL=static/mascot.png
KBOUSAI_OPERATOR=
KBOUSAI_OPERATOR_URL=
# Google アナリティクス（空なら計測タグを出さない）
KBOUSAI_GA_ID=
# 各エンジンの画面へのリンク（空ならリンクを出さない）
KBOUSAI_LINK_KFLOOD=
KBOUSAI_LINK_KHAZARD=
KBOUSAI_LINK_KTSUNAMI=
KBOUSAI_LINK_KREFUGE=
