[Unit]
Description=Kurage 防災AIチャット (kbousai) :18393
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/kbousai
EnvironmentFile=-/home/kojima/work/kbousai/.env
ExecStart=/home/kojima/work/kbousai/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18393
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
